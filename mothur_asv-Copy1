#!/usr/bin/env bash
# mothur_asv  SEQS.fasta  SILVA.db  SILVA.tax  OUT_ASV.tsv  OUT_TAX.tsv
# ---------------------------------------------------------------------------
# Builds a per-sample ASV table WITHOUT collapsing. Each KEBJ01 sequence is
# its own ASV, placed in the sample given by its header (Bv4v5-<SAMPLE>_...),
# and classified against SILVA. Avoids unique.seqs, which was merging all
# 1.3M sequences into one.
# ---------------------------------------------------------------------------
set -euo pipefail
SEQS="$1"; SILVA_DB="$2"; SILVA_TAX="$3"; OUT_ASV="$4"; OUT_TAX="$5"
CORES="${PEGASUS_CORES:-8}"
log(){ echo "[mothur_asv $(date +%H:%M:%S)] $*"; }

SEQS="$(readlink -f "$SEQS")"
SILVA_DB="$(readlink -f "$SILVA_DB")"
SILVA_TAX="$(readlink -f "$SILVA_TAX")"
OA_DIR="$(cd "$(dirname "$OUT_ASV")" && pwd)"; OUT_ASV="$OA_DIR/$(basename "$OUT_ASV")"
OT_DIR="$(cd "$(dirname "$OUT_TAX")" && pwd)"; OUT_TAX="$OT_DIR/$(basename "$OUT_TAX")"
for f in "$SEQS" "$SILVA_DB" "$SILVA_TAX"; do [ -s "$f" ] || { log "ERROR missing $f"; exit 1; }; done

WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
cd "$WORK"
log "sequences in input: $(grep -c '^>' "$SEQS")"

# 1. clean fasta (simplify headers) + build the per-sample ASV COUNT TABLE
#    directly — each sequence = 1 ASV, count 1 in its sample. NO uniquing.
log "building per-sample ASV table (each sequence = its own ASV)"
python3 - "$SEQS" "$WORK/seqs.fasta" "$WORK/asv_table.tsv" <<'PY'
import sys, re
infa, outfa, outtab = sys.argv[1:4]
# first pass: collect sequences + their sample
recs=[]  # (seqid, sample)
samples=set()
with open(infa) as fi, open(outfa,"w") as fo:
    sid=None; samp=None; seq=[]
    def flush():
        if sid:
            fo.write(">"+sid+"\n"+"".join(seq)+"\n")
            recs.append((sid,samp)); samples.add(samp)
    for line in fi:
        if line.startswith(">"):
            flush()
            sid=line[1:].split()[0]
            m=re.search(r'Bv4v5-([A-Za-z0-9]+)_', line)
            samp=m.group(1) if m else "unknown"
            seq=[]
        else:
            seq.append(line.strip())
    flush()
samples=sorted(samples)
# write ASV table: ASV  total  <sample columns...>  (plain integer counts)
with open(outtab,"w") as ft:
    ft.write("ASV\ttotal\t"+"\t".join(samples)+"\n")
    for sid,samp in recs:
        row=[sid,"1"]+["1" if s==samp else "0" for s in samples]
        ft.write("\t".join(row)+"\n")
print(f"[asv] {len(recs)} ASVs across {len(samples)} samples: {' '.join(samples)}")
PY
NASV=$(($(wc -l < "$WORK/asv_table.tsv") - 1))
log "ASV table: $NASV ASVs"

# 2. classify all sequences against SILVA (no uniquing, no count collapsing)
log "classifying $NASV sequences against SILVA (several minutes)"
# mothur classify.seqs needs a count or name; make a trivial count_table
# (each seq counted once) so classify runs, then we keep OUR asv_table.
python3 - "$WORK/seqs.fasta" "$WORK/trivial.count_table" <<'PY'
import sys
fa=sys.argv[1]; out=sys.argv[2]
ids=[l[1:].split()[0] for l in open(fa) if l.startswith(">")]
with open(out,"w") as f:
    f.write("Representative_Sequence\ttotal\n")
    for i in ids: f.write(i+"\t1\n")
PY
set +e
mothur "#classify.seqs(fasta=$WORK/seqs.fasta, count=$WORK/trivial.count_table, reference=$SILVA_DB, taxonomy=$SILVA_TAX, processors=$CORES)"
RC=$?
set -e
echo "===== mothur log tail ====="; cat mothur.*.logfile 2>/dev/null | tail -20 || true; echo "==========================="
log "mothur exit: $RC"
[ "$RC" -ne 0 ] && { log "classify failed"; exit "$RC"; }

# 3. write outputs: OUR asv_table (real per-sample) + parsed taxonomy
cp "$WORK/asv_table.tsv" "$OUT_ASV"
python3 - "$WORK" "$OUT_TAX" <<'PY'
import sys, glob, os, csv
work, out_tax = sys.argv[1:3]
tax=glob.glob(os.path.join(work,"*.wang.taxonomy"))
ranks=["Domain","Phylum","Class","Order","Family","Genus"]
with open(out_tax,"w",newline="") as fo:
    w=csv.writer(fo,delimiter="\t"); w.writerow(["ASV"]+ranks)
    if tax:
        for line in open(tax[0]):
            p=line.rstrip("\n").split("\t")
            if len(p)<2: continue
            parts=[x.split("(")[0] for x in p[1].strip(";").split(";")]
            w.writerow([p[0]]+(parts+["NA"]*6)[:6])
print("[tax] wrote taxonomy")
PY
log "output: ASV=$(wc -l < "$OUT_ASV") lines, TAX=$(wc -l < "$OUT_TAX") lines"
[ "$NASV" -lt 2 ] && log "WARNING: still few ASVs — check headers"
log "DONE"
