#!/usr/bin/env Rscript
# carbon_flux  GEOCHEM.csv  CELL_COUNTS.csv  FLUX_PARAMS.yml  OUT.tsv
# ---------------------------------------------------------------------------
# Estimates subsurface microbial carbon-fixation flux per site from cell
# densities and the fixation-rate parameters. Robust to column-format quirks.
# ---------------------------------------------------------------------------
suppressMessages({ library(yaml) })

args      <- commandArgs(trailingOnly = TRUE)
geo_file  <- args[1]
cell_file <- args[2]
par_file  <- args[3]
out_file  <- args[4]

cells <- read.csv(cell_file, check.names = FALSE, stringsAsFactors = FALSE)

# parameters (coerce every value to numeric)
P <- yaml::read_yaml(par_file)
rate_per_cell <- suppressWarnings(as.numeric(P$fixation_rate_per_cell))
depth_m       <- suppressWarnings(as.numeric(P$integration_depth_m))
porosity      <- suppressWarnings(as.numeric(P$porosity))
if (is.na(rate_per_cell)) rate_per_cell <- 6.3e-15
if (is.na(depth_m))       depth_m       <- 1000
if (is.na(porosity))      porosity      <- 0.1

# find the cells-per-ml column by name (fall back to any numeric column)
cell_col <- NULL
for (nm in names(cells)) {
  if (grepl("cell", nm, ignore.case = TRUE) && grepl("ml|count|per", nm, ignore.case = TRUE)) {
    cell_col <- nm; break
  }
}
if (is.null(cell_col)) {
  num <- names(cells)[sapply(cells, function(c) suppressWarnings(all(!is.na(as.numeric(as.character(c))))))]
  num <- setdiff(num, names(cells)[1])          # skip the sample/site id column
  cell_col <- if (length(num)) num[1] else names(cells)[2]
}

# site names = first column ; counts = the detected column, forced numeric
site_col <- names(cells)[1]
counts   <- suppressWarnings(as.numeric(as.character(cells[[cell_col]])))
counts[is.na(counts)] <- 0                       # missing -> 0 (no crash)

flux <- data.frame(site = as.character(cells[[site_col]]),
                   cells_per_ml = counts,
                   stringsAsFactors = FALSE)
flux$flux_mol_C_m2_yr <-
  flux$cells_per_ml * 1e6 * rate_per_cell * depth_m * porosity

write.table(flux, out_file, sep = "\t", row.names = FALSE, quote = FALSE)
cat(sprintf("[carbon_flux] %d sites (col=%s) -> %s\n", nrow(flux), cell_col, out_file))
