#!/usr/bin/env bash
# refine CONTIGS SEMIBIN.tar COMEBIN.tar VAMB.tar OUT_MAGS  — DAS Tool consolidation
# Robust to empty binner outputs (e.g. small/subsampled test data): if no bins
# were produced, writes an empty MAGs file and exits cleanly so the DAG continues.
set -euo pipefail
C="$(readlink -f "$1")"; SB="$(readlink -f "$2")"; CB="$(readlink -f "$3")"; VB="$(readlink -f "$4")"; OUT="$5"
W="$(mktemp -d)"; trap 'rm -rf "$W"' EXIT
log(){ echo "[refine $(date +%H:%M:%S)] $*"; }

# unpack each binner's output
for t in "$SB:semibin" "$CB:comebin" "$VB:vamb"; do
  f="${t%%:*}"; n="${t##*:}"; mkdir -p "$W/$n"; tar -xf "$f" -C "$W/$n" 2>/dev/null || true
done

# build DAS Tool contig2bin tables from each binner's fasta bins
command -v Fasta_to_Contig2Bin.sh >/dev/null 2>&1 && FTO=Fasta_to_Contig2Bin.sh || FTO=Fasta_to_Scaffolds2Bin.sh
TABS=""; LABELS=""
for n in semibin comebin vamb; do
  bd=$(find "$W/$n" -type d -name "*bins*" 2>/dev/null | head -1); [ -z "$bd" ] && bd="$W/$n"
  if ls "$bd"/*.fa >/dev/null 2>&1; then EXT=fa
  elif ls "$bd"/*.fasta >/dev/null 2>&1; then EXT=fasta
  else log "no bins from $n"; continue; fi
  if $FTO -i "$bd" -e "$EXT" > "$W/$n.tsv" 2>/dev/null && [ -s "$W/$n.tsv" ]; then
    TABS="$TABS,$W/$n.tsv"; LABELS="$LABELS,$n"
  fi
done
TABS="${TABS#,}"; LABELS="${LABELS#,}"

# if NO binner produced bins, emit an empty MAGs file and finish cleanly
if [ -z "$TABS" ]; then
  log "WARNING: no bins from any binner (common with small/subsampled data)"
  : > "$OUT"
  log "wrote empty $OUT — DAG continues"
  exit 0
fi

# run DAS Tool on whatever binners produced bins
DAS_Tool -i "$TABS" -l "$LABELS" -c "$C" -o "$W/das" \
  --threads "${PEGASUS_CORES:-16}" --write_bins 2>/dev/null || log "DAS Tool had issues"

# concatenate refined MAGs with bin-id headers (awk, no python dependency)
> "$OUT"
BINDIR="$W/das_DASTool_bins"
if [ -d "$BINDIR" ] && ls "$BINDIR"/*.fa >/dev/null 2>&1; then
  for f in "$BINDIR"/*.fa; do
    b=$(basename "$f" .fa)
    awk -v b="$b" '/^>/{print ">"b"__"substr($0,2); next} {print}' "$f" >> "$OUT"
  done
else
  # fallback: use semibin bins directly
  for f in $(find "$W/semibin" -name "*.fa" 2>/dev/null); do
    b=$(basename "$f" .fa)
    awk -v b="$b" '/^>/{print ">"b"__"substr($0,2); next} {print}' "$f" >> "$OUT"
  done
fi
log "wrote $OUT ($(grep -c '^>' "$OUT" 2>/dev/null || echo 0) sequences)"
