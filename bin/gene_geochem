#!/usr/bin/env Rscript
# gene_geochem  GENE_CLIQUES.rds  GEOCHEM.csv  GENE_CLIQUE_ENV.tsv
# rTCA gene-clique (B) is expected to correlate best with DIC.
a <- commandArgs(trailingOnly=TRUE)
obj <- readRDS(a[1]); env <- read.csv(a[2], row.names=1, check.names=FALSE); out <- a[3]
m <- obj$matrix; mem <- obj$membership
num_env <- env[, sapply(env, is.numeric), drop=FALSE]
samples <- intersect(colnames(m), rownames(num_env))
m <- m[, samples, drop=FALSE]; num_env <- num_env[samples, , drop=FALSE]
res <- list()
for (cl in sort(unique(mem))) {
  members <- names(mem)[mem == cl]
  ab <- colSums(m[rownames(m) %in% members, , drop=FALSE], na.rm=TRUE)
  for (v in colnames(num_env)) {
    x <- num_env[[v]]; ok <- is.finite(x) & is.finite(ab)
    if (sum(ok) < 4) next
    sp <- suppressWarnings(cor.test(x[ok], ab[ok], method="spearman"))
    res[[length(res)+1]] <- data.frame(gene_clique=cl, variable=v,
      spearman_rho=unname(sp$estimate), spearman_p=sp$p.value)
  }
}
tab <- do.call(rbind, res)
tab$spearman_p_holm <- p.adjust(tab$spearman_p, method="holm")
write.table(tab, out, sep="\t", row.names=FALSE, quote=FALSE)
cat("[gene_geochem] wrote", nrow(tab), "gene-clique-variable tests\n")
