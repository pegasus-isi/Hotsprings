#!/usr/bin/env bash
# mifaser  R1.trim.fq.gz  R2.trim.fq.gz  ENZYME_ABUND.tsv
# Annotates reads to EC numbers using mi-faser's built-in Gold-Standard-Plus
# database (bundled in the container; referenced by name, not a staged file).
set -euo pipefail
R1="$1"; R2="$2"; OUT="$3"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
mifaser -f -1 "$R1" -2 "$R2" -d GS+ -o "$TMP/mif" -c "${PEGASUS_CORES:-8}"
# mifaser writes analysis.tsv with EC \t count
cp "$TMP/mif/analysis.tsv" "$OUT"
echo "[mifaser] wrote $OUT"
