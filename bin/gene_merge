#!/usr/bin/env Rscript
# gene_merge  s1_enzymes.tsv [s2_enzymes.tsv ...]  GENE_TABLE.tsv
# Merges per-sample mi-faser EC->readcount tables into an EC x sample matrix,
# normalises each sample to library size x median (as in the 16S normalisation).
a <- commandArgs(trailingOnly=TRUE)
out <- a[length(a)]; ins <- a[-length(a)]
merged <- NULL
for (f in ins) {
  s <- sub("_enzymes\\.tsv$","", basename(f))
  d <- read.csv(f, sep="\t", header=TRUE, check.names=FALSE)
  # expect columns EC/ec and count/readcount (mi-faser analysis.tsv)
  names(d) <- tolower(names(d))
  ec_col <- grep("^ec", names(d), value=TRUE)[1]
  ct_col <- grep("count", names(d), value=TRUE)[1]
  d <- d[, c(ec_col, ct_col)]; names(d) <- c("EC", s)
  merged <- if (is.null(merged)) d else merge(merged, d, by="EC", all=TRUE)
}
rownames(merged) <- merged$EC; merged$EC <- NULL
merged[is.na(merged)] <- 0
med <- median(colSums(merged))
norm <- sweep(merged, 2, colSums(merged), "/") * med    # rel. abund x median
write.table(data.frame(EC=rownames(norm), norm, check.names=FALSE),
            out, sep="\t", row.names=FALSE, quote=FALSE)
cat("[gene_merge] ECs:", nrow(norm), " samples:", ncol(norm), "\n")
