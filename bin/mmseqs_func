#!/usr/bin/env bash
# mmseqs_func  MAGS  OUT_FUNC   — MMseqs2 functional search vs UniRef50 (GPU)
set -euo pipefail
MG="$(readlink -f "$1")"; OUT="$2"; W="$(mktemp -d)"; trap 'rm -rf "$W"' EXIT
DB="${MAG_FUNC_DB:-/global/cfs/cdirs/m4144/hsafri/refs/mmseqs/uniref50}"
CORES="${PEGASUS_CORES:-16}"
mmseqs easy-search "$MG" "$DB" "$OUT" "$W/tmp" --threads "$CORES" ${MAG_GPU:+--gpu 1} \
  --format-output "query,target,evalue,bits,pident" 2>/dev/null || \
  mmseqs easy-search "$MG" "$DB" "$OUT" "$W/tmp" --threads "$CORES" \
  --format-output "query,target,evalue,bits,pident"
echo "[mmseqs_func] -> $OUT"
