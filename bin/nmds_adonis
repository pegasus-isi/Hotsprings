#!/usr/bin/env Rscript

# nmds_adonis FILTERED.rds GEOCHEM.csv NMDS.tsv ADONIS.tsv FIG.pdf
# Ordinate samples with NMDS on Bray-Curtis distances and test individual
# numeric environmental variables with PERMANOVA (vegan::adonis2).

suppressPackageStartupMessages({
    library(phyloseq)
    library(vegan)
    library(ggplot2)
})

args <- commandArgs(trailingOnly = TRUE)
if (length(args) != 5L) {
    stop(
        "Usage: nmds_adonis FILTERED.rds GEOCHEM.csv NMDS.tsv ADONIS.tsv FIG.pdf",
        call. = FALSE
    )
}

in_file    <- args[[1L]]
geo_file   <- args[[2L]]
nmds_out   <- args[[3L]]
adonis_out <- args[[4L]]
fig_out    <- args[[5L]]

physeq <- readRDS(in_file)
if (!inherits(physeq, "phyloseq")) {
    stop("FILTERED.rds does not contain a phyloseq object", call. = FALSE)
}

otu <- otu_table(physeq)
abund <- as(otu, "matrix")
if (taxa_are_rows(otu)) abund <- t(abund)

if (is.null(dim(abund)) || nrow(abund) == 0L || ncol(abund) == 0L) {
    stop("The abundance matrix has zero samples or zero ASVs", call. = FALSE)
}

storage.mode(abund) <- "double"
abund[!is.finite(abund)] <- 0
if (any(abund < 0)) {
    stop("The abundance matrix contains negative values", call. = FALSE)
}

geo_raw <- read.csv(
    geo_file,
    check.names = FALSE,
    stringsAsFactors = FALSE
)

if (nrow(geo_raw) == 0L || ncol(geo_raw) == 0L) {
    stop("geochem.csv has no data rows or columns", call. = FALSE)
}

# Find the sample-ID column instead of assuming that read.csv(row.names=1)
# interpreted the file correctly. Formatting differences that do not change
# identity (case, spaces, underscores, and hyphens) are ignored for matching.
canonical_id <- function(x) {
    toupper(gsub("[^A-Z0-9]", "", trimws(as.character(x))))
}

canonical_columns <- canonical_id(names(geo_raw))
preferred_id_columns <- c("SAMPLE", "SAMPLEID", "SITE", "SITEID", "ID", "NAME")
id_column <- match(preferred_id_columns, canonical_columns, nomatch = 0L)
id_column <- id_column[id_column > 0L]

if (length(id_column) > 0L) {
    id_column <- id_column[[1L]]
} else {
    first_column <- geo_raw[[1L]]
    first_ids <- canonical_id(first_column)
    if (all(nzchar(first_ids)) && !anyDuplicated(first_ids)) {
        id_column <- 1L
    } else {
        stop(
            paste0(
                "Could not identify the sample-ID column in geochem.csv. ",
                "Available columns: ", paste(names(geo_raw), collapse = ", ")
            ),
            call. = FALSE
        )
    }
}

geo_ids_raw <- trimws(as.character(geo_raw[[id_column]]))

# Fullerton geochemistry identifiers use strings such as
# "DCO_LLO_Bv4v5..BRF1_BR170218_1", while phyloseq uses "BRF1". Extract the
# token between ".." and the following underscore when that format is found.
embedded_id <- grepl("\\.\\.[^_]+_", geo_ids_raw)
geo_ids <- geo_ids_raw
geo_ids[embedded_id] <- sub(
    "^.*\\.\\.([^_]+)_.*$",
    "\\1",
    geo_ids_raw[embedded_id]
)
geo_keys <- canonical_id(geo_ids)
sample_ids <- rownames(abund)
sample_keys <- canonical_id(sample_ids)

if (any(!nzchar(geo_keys)) || anyDuplicated(geo_keys)) {
    stop("The geochemistry sample-ID column contains blank or duplicate IDs",
         call. = FALSE)
}
if (any(!nzchar(sample_keys)) || anyDuplicated(sample_keys)) {
    stop("The phyloseq object contains blank or duplicate sample IDs",
         call. = FALSE)
}

common_keys <- intersect(sample_keys, geo_keys)
if (length(common_keys) < 3L) {
    stop(
        paste0(
            "Fewer than three sample IDs match. Phyloseq samples: ",
            paste(sample_ids, collapse = ", "),
            ". Geochemistry IDs from column '", names(geo_raw)[id_column],
            "': ", paste(geo_ids, collapse = ", ")
        ),
        call. = FALSE
    )
}

sample_positions <- match(common_keys, sample_keys)
geo_positions <- match(common_keys, geo_keys)
abund <- abund[sample_positions, , drop = FALSE]
geo <- geo_raw[geo_positions, -id_column, drop = FALSE]
rownames(geo) <- rownames(abund)

message(
    "Matched ", length(common_keys), " samples using geochemistry column '",
    names(geo_raw)[id_column], "'"
)

# Remove empty samples and taxa after aligning the two inputs. Subsetting the
# plain matrix avoids constructing an invalid zero-dimensional otu_table.
keep_samples <- rowSums(abund, na.rm = TRUE) > 0
abund <- abund[keep_samples, , drop = FALSE]
geo <- geo[keep_samples, , drop = FALSE]

if (nrow(abund) < 3L) {
    stop("Fewer than three nonempty matched samples remain", call. = FALSE)
}

keep_taxa <- colSums(abund, na.rm = TRUE) > 0
abund <- abund[, keep_taxa, drop = FALSE]
if (ncol(abund) == 0L) {
    stop("No nonzero ASVs remain after matching samples", call. = FALSE)
}

# NMDS on Bray-Curtis distances.
dist_bc <- vegdist(abund, method = "bray")
if (any(!is.finite(as.vector(dist_bc)))) {
    stop("Bray-Curtis distance contains non-finite values", call. = FALSE)
}
if (all(as.vector(dist_bc) == 0)) {
    stop("All Bray-Curtis distances are zero; NMDS is undefined", call. = FALSE)
}

set.seed(42)
ord <- metaMDS(dist_bc, k = 2, trymax = 100, trace = FALSE)

scores_df <- as.data.frame(scores(ord, display = "sites"))
scores_df$sample <- rownames(scores_df)
write.table(
    scores_df,
    nmds_out,
    sep = "\t",
    row.names = FALSE,
    quote = FALSE
)

# Test each numeric variable separately. These are univariate associations,
# not effects adjusted for all other environmental variables.
num_vars <- names(geo)[vapply(geo, is.numeric, logical(1L))]
results <- list()
result_index <- 1L

for (variable in num_vars) {
    value <- geo[[variable]]
    valid <- is.finite(value)
    if (sum(valid) < 3L || length(unique(value[valid])) < 2L) next

    distance_subset <- as.dist(
        as.matrix(dist_bc)[valid, valid, drop = FALSE]
    )
    metadata_subset <- data.frame(
        value = value[valid],
        row.names = rownames(geo)[valid]
    )

    set.seed(42)
    fit <- tryCatch(
        adonis2(
            distance_subset ~ value,
            data = metadata_subset,
            permutations = 999
        ),
        error = function(e) {
            warning("Skipping ", variable, ": ", conditionMessage(e))
            NULL
        }
    )
    if (is.null(fit)) next

    results[[result_index]] <- data.frame(
        variable = variable,
        samples = sum(valid),
        R2 = fit$R2[[1L]],
        p_value = fit$`Pr(>F)`[[1L]],
        stringsAsFactors = FALSE
    )
    result_index <- result_index + 1L
}

if (length(results) == 0L) {
    adonis_df <- data.frame(
        variable = character(),
        samples = integer(),
        R2 = numeric(),
        p_value = numeric(),
        q_value = numeric()
    )
} else {
    adonis_df <- do.call(rbind, results)
    adonis_df$q_value <- p.adjust(adonis_df$p_value, method = "BH")
    adonis_df <- adonis_df[order(adonis_df$q_value, -adonis_df$R2), ]
}

write.table(
    adonis_df,
    adonis_out,
    sep = "\t",
    row.names = FALSE,
    quote = FALSE
)

plot <- ggplot(scores_df, aes(NMDS1, NMDS2)) +
    geom_point(size = 3, color = "#1E6FB4") +
    geom_text(aes(label = sample), vjust = -0.8, size = 2.5) +
    theme_minimal() +
    labs(
        title = "16S community NMDS (Bray-Curtis)",
        subtitle = sprintf("Stress = %.3f", ord$stress)
    )

ggsave(fig_out, plot, width = 7, height = 6)

cat(sprintf(
    "[nmds_adonis] %d samples; stress=%.3f; %d variables tested -> %s, %s\n",
    nrow(abund), ord$stress, nrow(adonis_df), nmds_out, adonis_out
))
