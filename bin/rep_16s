#!/usr/bin/env Rscript
# rep_16s  COUNT.csv  SAMPLE.csv  CLIQUES.rds  CLIQUE_ENV.tsv  NMDS.tsv  ADONIS.tsv  FIG.pdf
# Reproduces the 16S analysis of Fullerton et al. directly from the authors'
# published tables (bac_normalized_count.csv = ASVs x samples, already
# normalized; bac_sample_table.csv = environmental data, rownames = sample).
suppressMessages({library(vegan); library(igraph); library(ggplot2)})
have_vsurf <- requireNamespace("VSURF", quietly=TRUE)
a <- commandArgs(trailingOnly=TRUE)
count_f<-a[1]; samp_f<-a[2]; clq_out<-a[3]; cg_out<-a[4]; nmds_out<-a[5]; adonis_out<-a[6]; fig_out<-a[7]

count <- as.matrix(read.csv(count_f, row.names=1, check.names=FALSE))   # ASVs x samples
samp  <- read.csv(samp_f, row.names=1, check.names=FALSE)               # rows = sample names
common <- intersect(colnames(count), rownames(samp))
stopifnot(length(common) > 4)
count <- count[, common, drop=FALSE]; samp <- samp[common, , drop=FALSE]
cat(sprintf("[rep_16s] %d ASVs x %d samples\n", nrow(count), ncol(count)))

# --- dominant-ASV set: present in >=3 samples, then cap to the most abundant ---
keep <- rowSums(count > 0) >= 3 & rowSums(count) > 0
m <- count[keep, , drop=FALSE]
CAP <- 4000                                   # keep network computable (authors ~3935 nodes)
if (nrow(m) > CAP) m <- m[order(rowSums(m), decreasing=TRUE)[1:CAP], , drop=FALSE]
cat(sprintf("[rep_16s] dominant ASVs for network: %d\n", nrow(m)))

# --- NMDS (Jaccard) + ADONIS on geology factors (Fig. 2) ---
comm <- t(count[keep, , drop=FALSE])          # samples x ASVs
ord  <- metaMDS(comm, distance="jaccard", trymax=60, trace=0)
sc   <- as.data.frame(scores(ord, display="sites")); sc$sample <- rownames(sc)
write.table(sc, nmds_out, sep="\t", row.names=FALSE, quote=FALSE)

factors <- intersect(c("type","plate","province","simpl_prov","region",
                       "geol_prov","rocks","volcano","anions","cations"), colnames(samp))
d <- vegdist(comm, method="jaccard")
rows <- list()
for (f in factors) {
  meta <- samp; meta[[f]] <- as.factor(meta[[f]])
  res <- try(adonis2(as.formula(paste("d ~", f)), data=meta, permutations=999), silent=TRUE)
  if (!inherits(res,"try-error")) rows[[f]] <- data.frame(factor=f, R2=res$R2[1], p=res$`Pr(>F)`[1])
}
at <- do.call(rbind, rows); if (!is.null(at)) at$p_holm <- p.adjust(at$p, method="holm")
write.table(at, adonis_out, sep="\t", row.names=FALSE, quote=FALSE)
cat(sprintf("[rep_16s] NMDS stress %.3f\n", ord$stress))

# --- co-occurrence network (Spearman rho>0.7) + Louvain cliques (Fig. 3a) ---
cc <- cor(t(m), method="spearman"); cc[is.na(cc)] <- 0
g  <- igraph::simplify(graph.adjacency(cc, mode="undirected", weighted=TRUE, diag=FALSE))
g  <- delete_edges(g, E(g)[E(g)$weight <= 0.7])
g  <- delete_vertices(g, V(g)[degree(g)==0])
lou <- cluster_louvain(g)
saveRDS(list(graph=g, membership=membership(lou), matrix=m, modularity=modularity(lou)), clq_out)
cat(sprintf("[rep_16s] network: %d nodes, %d edges, %d cliques (Q=%.3f)\n",
            vcount(g), ecount(g), length(lou), modularity(lou)))

# --- clique abundance vs geochemistry (Fig. 3b): Spearman + Pearson, VSURF ---
mem <- membership(lou)
num_env <- samp[, sapply(samp, is.numeric), drop=FALSE]
res <- list()
for (cl in sort(unique(mem))) {
  members <- names(mem)[mem==cl]
  ab <- colSums(m[rownames(m) %in% members, , drop=FALSE], na.rm=TRUE)
  for (v in colnames(num_env)) {
    x <- num_env[[v]]; ok <- is.finite(x) & is.finite(ab)
    if (sum(ok) < 4) next
    sp <- suppressWarnings(cor.test(x[ok], ab[ok], method="spearman"))
    pe <- suppressWarnings(cor.test(x[ok], ab[ok], method="pearson"))
    res[[length(res)+1]] <- data.frame(clique=cl, variable=v,
      spearman_rho=unname(sp$estimate), spearman_p=sp$p.value,
      pearson_r=unname(pe$estimate), pearson_p=pe$p.value)
  }
  if (have_vsurf) {
    df <- na.omit(data.frame(y=ab, num_env))
    if (nrow(df) >= 8 && ncol(df) > 2) {
      vs <- try(VSURF::VSURF(y ~ ., data=df, ntree=500, verbose=FALSE), silent=TRUE)
      if (!inherits(vs,"try-error") && length(vs$varselect.pred))
        cat(sprintf("[rep_16s] clique %d RF top var: %s\n", cl, colnames(df)[-1][vs$varselect.pred[1]]))
    }
  }
}
tab <- do.call(rbind, res); tab$spearman_p_holm <- p.adjust(tab$spearman_p, method="holm")
write.table(tab, cg_out, sep="\t", row.names=FALSE, quote=FALSE)

p <- ggplot(sc, aes(NMDS1, NMDS2, label=sample)) + geom_point(size=3) +
     geom_text(vjust=-0.8, size=3) + theme_minimal() +
     labs(title="16S community NMDS (Jaccard) - reproduced")
ggsave(fig_out, p, width=7, height=6)
cat("[rep_16s] done\n")
