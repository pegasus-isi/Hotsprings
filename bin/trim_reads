#!/usr/bin/env bash
# trim_reads  IN_R1.fastq.gz  IN_R2.fastq.gz  OUT_R1.fastq.gz  OUT_R2.fastq.gz
# Quality-trims the staged paired reads (trimmomatic).
set -euo pipefail
IN1="$1"; IN2="$2"; OUT1="$3"; OUT2="$4"
CORES="${PEGASUS_CORES:-4}"
trimmomatic PE -threads "$CORES" \
  "$IN1" "$IN2" "$OUT1" /dev/null "$OUT2" /dev/null \
  SLIDINGWINDOW:4:20 MINLEN:50
echo "[trim_reads] wrote $OUT1 + $OUT2"
