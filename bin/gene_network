#!/usr/bin/env Rscript
# gene_network  GENE_TABLE.tsv  OUT_CLIQUES.rds
# Co-occurrence network of carbon-fixation ECs across samples -> cliques.
suppressMessages({ library(igraph) })
args <- commandArgs(trailingOnly = TRUE)
in_file <- args[1]; out_file <- args[2]

d   <- read.delim(in_file, header = TRUE, check.names = FALSE)
mat <- as.matrix(d[, -1, drop = FALSE])          # rows = ECs, cols = samples
rownames(mat) <- as.character(d[[1]])

cor_mat <- suppressWarnings(cor(t(mat), method = "spearman"))
cor_mat[is.na(cor_mat)] <- 0
adj <- (cor_mat >= 0.7) * 1; diag(adj) <- 0

g <- graph_from_adjacency_matrix(adj, mode = "undirected", diag = FALSE)
cliques_list <- max_cliques(g, min = 3)
saveRDS(list(graph = g, cliques = cliques_list), out_file)
cat(sprintf("[gene_network] %d ECs, %d cliques -> %s\n",
            vcount(g), length(cliques_list), out_file))
