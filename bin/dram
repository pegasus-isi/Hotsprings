#!/usr/bin/env bash
# dram  MAG_FASTA  OUT_ANNOT   — KO annotation via KOfam. Handles empty MAGs.
set -uo pipefail
MG="$(readlink -f "$1")"; OUT="$2"
W="$(mktemp -d)"; trap 'rm -rf "$W"' EXIT
CORES="${PEGASUS_CORES:-16}"
KODB="${MAG_KOFAM_DB:-/global/cfs/cdirs/m4144/hsafri/refs/kofam_db}"

# guard: empty MAGs -> empty annotation, exit clean
if [ ! -s "$MG" ] || ! grep -q "^>" "$MG" 2>/dev/null; then
  echo "[dram/kofam] WARNING: MAGs empty — writing empty annotation"
  printf "gene\tko\n" > "$OUT"; exit 0
fi

# predict genes if nucleotide
if grep -qE '^[ACGTNacgtn]+$' <(grep -v '^>' "$MG" | head -1); then
  prodigal -i "$MG" -a "$W/genes.faa" -p meta -q
  FAA="$W/genes.faa"
else
  FAA="$MG"
fi

if command -v exec_annotation >/dev/null 2>&1; then
  exec_annotation -o "$OUT" -f detail-tsv -p "$KODB/profiles" -k "$KODB/ko_list" --cpu "$CORES" "$FAA" || \
    { echo -e "gene\tko" > "$OUT"; }
else
  HMM="$KODB/profiles.hmm"
  [ ! -s "$HMM" ] && { cat "$KODB"/profiles/*.hmm > "$W/all.hmm" 2>/dev/null && HMM="$W/all.hmm"; }
  hmmsearch --cpu "$CORES" --tblout "$W/hits.tbl" "$HMM" "$FAA" >/dev/null 2>&1 || true
  { echo -e "gene\tko"; awk '!/^#/{print $1"\t"$3}' "$W/hits.tbl" 2>/dev/null; } > "$OUT"
fi
echo "[dram/kofam] -> $OUT"
