#!/usr/bin/env Rscript
# rep_carbon_flux  SAMPLE.csv  FLUX_PARAMS.yml  FLUX.tsv
# Carbon-flux estimate (Methods Eqs 1-4) using cell densities (cells_flu) and
# DOC from the authors' sample table + the Magnabosco depth integration.
suppressMessages({library(yaml)})
a <- commandArgs(trailingOnly=TRUE)
samp_f<-a[1]; par_f<-a[2]; out<-a[3]
samp <- read.csv(samp_f, check.names=FALSE)
P <- yaml::read_yaml(par_f)

cells_col <- intersect(c("cells_flu","cell_flu","cells"), names(samp))[1]
doc_col   <- intersect(c("doc"), names(samp))[1]
cells_mean <- mean(suppressWarnings(as.numeric(samp[[cells_col]])), na.rm=TRUE)  # cells/ml
doc_mean   <- mean(suppressWarnings(as.numeric(samp[[doc_col]])),   na.rm=TRUE)  # mmolC/l

# Magnabosco arc-crust depth integration (cells above the 122C isotherm)
A.m<-P$A+6; B<-P$B
z.iso<-P$isotherm_depth_m; x.m<-P$trench_to_arc_m; y.m<-P$along_trench_m
grid<-seq(0,x.m,by=1000); z_at<-z.iso*(1-grid/x.m)
col<-sapply(z_at, function(z) if (z>0) 10^A.m*z^(B+1)/(B+1) else 0)
n.cells<-sum(col*1000*y.m, na.rm=TRUE)

gC<-12.011; Ccells<-P$C_per_cell_gC; fauto<-P$f_autotroph; fatt<-P$f_attached; t2<-P$turnover_yr
Cmantle<-P$C_mantle_molC_yr
Cbio_mol<-n.cells*Ccells*fatt/gC
flux<-Cbio_mol*fauto/t2
pct<-100*flux/Cmantle

res<-data.frame(quantity=c("mean_cells_per_ml","mean_DOC_mmolC_per_l",
  "cells_integrated","biomass_C_molC","biomass_flux_molC_yr","pct_of_mantle_input"),
  value=c(cells_mean, doc_mean, n.cells, Cbio_mol, flux, pct))
write.table(res, out, sep="\t", row.names=FALSE, quote=FALSE)
cat(sprintf("[rep_carbon_flux] biomass C = %.2e molC | %.1f%% of mantle input\n", Cbio_mol, pct))
