# mi-faser enzyme annotation on an Ubuntu base (bash/curl available).
FROM ubuntu:22.04
COPY --from=bromberglab/mifaser /app /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash curl wget python3 python3-pip ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
