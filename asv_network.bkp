#!/usr/bin/env Rscript
# asv_network  FILTERED.rds  OUT_CLIQUES.rds
# ---------------------------------------------------------------------------
# Builds a co-occurrence network from the normalized ASV table and extracts
# maximal cliques (tightly co-occurring ASV groups), following the paper.
# ---------------------------------------------------------------------------
suppressMessages({
  library(phyloseq)
  library(igraph)
})

args      <- commandArgs(trailingOnly = TRUE)
in_file   <- args[1]
out_file  <- args[2]

physeq <- readRDS(in_file)

# abundance matrix: rows = ASVs, columns = samples
abund <- as.matrix(otu_table(physeq))
if (!taxa_are_rows(physeq)) abund <- t(abund)

# ---- correlation between ASVs across samples -------------------------------
# Spearman correlation; keep strong positive associations only.
cor_mat <- suppressWarnings(cor(t(abund), method = "spearman"))
cor_mat[is.na(cor_mat)] <- 0
threshold <- 0.7
adj <- (cor_mat >= threshold) * 1
diag(adj) <- 0

# ---- build graph + extract cliques -----------------------------------------
g <- graph_from_adjacency_matrix(adj, mode = "undirected", diag = FALSE)
cliques_list <- max_cliques(g, min = 3)   # groups of >= 3 co-occurring ASVs

saveRDS(list(graph = g, cliques = cliques_list), out_file)
cat(sprintf("[asv_network] %d nodes, %d cliques (>=3) -> %s\n",
            vcount(g), length(cliques_list), out_file))
